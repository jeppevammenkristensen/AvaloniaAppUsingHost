<?xml version="1.0"?>
<package >
  <metadata>
    <id>AvaloniaAppUsingHost.Template</id>
    <version>4.1.0</version>
    <authors>Jeppe Roi Kristensen</authors>
    <owners>Jeppe Roi Kristensen</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <description>A batteries-included Avalonia application template with Microsoft.Extensions.Hosting, dependency injection, MVVM, tabbed screen lifecycle management, validation, progress reporting, and practical UI examples.</description>
    <summary>Avalonia application template using Microsoft.Extensions.Hosting and MVVM pattern.</summary>    
    <tags>avalonia template mvvm desktop</tags>
    <repository type="git" url="https://github.com/jeppevammenkristensen/AvaloniaAppUsingHost" />
    <releaseNotes>
      - Added a Framework option for .NET 10 (default) and .NET 11, with matching Microsoft.Extensions.Hosting versions.
      - Fixed the template primary output to reference the generated .slnx solution.      
    </releaseNotes>
    <readme>docs/readme.md</readme>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
  <files>
    <file src="**\*" target="content" exclude="**\bin\**;**\obj\**;**\.idea\*;**\.vs\**;*sln.DotSettings*;docs\**" />
    <file src="docs\readme.md" target="docs\" />
  </files>
</package>
