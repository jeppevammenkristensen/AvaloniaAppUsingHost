{
  "$schema": "http://json.schemastore.org/template",
  "author": "Jeppe Roi Kristensen",
  "classifications": [ "Avalonia", "Desktop", "MVVM" ],
  "identity": "AvaloniaAppUsingHost.Template",
  "name": "Avalonia App Using Host",
  "description": "This template create a new Avalonia application with a Screen and using Host",
  "shortName": "avalonia-host",
  "sourceName": "AvaloniaAppUsingHost",
  "guids": [ "4c5218c3-567b-478a-8c01-e91450c9347d" ],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The target framework for the generated application.",
      "defaultValue": "net11.0",
      "replaces": "net10.0",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10"
        },
        {
          "choice": "net11.0",
          "description": ".NET 11"
        }
      ]
    },
    "HostingVersion": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "cases": [
          {
            "condition": "(Framework == \"net11.0\")",
            "value": "11.0.0"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.15"
          }
        ]
      },
      "replaces": "10.0.15"
    }
  },
  "sources": [
    {
      "modifiers" : [
        {
          "exclude": [ "packages/**", "docs/**" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "AvaloniaAppUsingHost.slnx"
    }
  ]

  
}
