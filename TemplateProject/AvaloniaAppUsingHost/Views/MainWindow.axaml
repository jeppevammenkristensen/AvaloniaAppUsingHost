<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaAppUsingHost.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="AvaloniaAppUsingHost.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}" IsEnabled="{Binding Loaded}">

    <Interaction.Behaviors>
        <EventTrigger EventName="Loaded">
            <InvokeCommandAction Command="{Binding StartupCommand}" />
        </EventTrigger>
    </Interaction.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <DockPanel Grid.Row="0">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="Open Primary" Command="{Binding LaunchPrimaryCommand}" />
                    <MenuItem Header="Open Validation Example" Command="{Binding LaunchValidationExampleCommand}" />
                    <MenuItem Header="Open Tree View" Command="{Binding LaunchTreeViewCommand}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <StackPanel IsVisible="{Binding !Loaded}" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <TextBlock Classes="Header" Text="Loading" HorizontalAlignment="Center" />
            <TextBlock Classes="Subtitle" Text="Preparing your workspace..." HorizontalAlignment="Center" />
        </StackPanel>

        <TabControl
            Name="TabControl"
            IsVisible="{Binding DisplayPanel}"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding Screens}"
            SelectedItem="{Binding Screen}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Name="TabTitleTextBox" Text="{Binding Title}" VerticalAlignment="Center">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding #Main.((vm:MainWindowViewModel)DataContext).CloseCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Close" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                        <Button Classes="TabCloseButton"
                                Command="{Binding #Main.((vm:MainWindowViewModel)DataContext).CloseCommand}"
                                CommandParameter="{Binding}"
                                Content="×"
                                ToolTip.Tip="Close tab" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Classes="Card">
                        <ContentControl Content="{Binding}" />
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding DisplayNoScreens}"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Classes="Accent"
                    Command="{Binding LaunchPrimaryCommand}"
                    Content="Open Primary" />
            <Button Command="{Binding LaunchValidationExampleCommand}"
                    Content="Open Validation Example" />
            <Button Command="{Binding LaunchTreeViewCommand}"
                    Content="Open Tree View" />
        </StackPanel>

        <Border Grid.Row="2" Classes.StatusBar="{Binding DisplayInfo}" Classes.StatusBarRed="{Binding DisplayInfoError}" Classes.StatusBarSuccess="{Binding DisplaySuccess}">
            <TextBlock Text="{Binding Status}" />
        </Border>

        <ProgressBar Grid.Row="3" ShowProgressText="False"
                     IsVisible="{Binding StartupCommand.IsRunning}" IsIndeterminate="False" Minimum="0" Maximum="100"
                     Value="{Binding CurrentProgress}" />
    </Grid>
</Window>
